offecho ==========================================echo   Setting Up CT20 Assembly Trackerecho ==========================================echo.REM 1. Create package.json(echo {echo   "name": "ct20-tracker",echo   "version": "1.0.0",echo   "main": "app.js",echo   "scripts": { "start": "node app.js" },echo   "dependencies": {echo     "express": "^4.18.2",echo     "socket.io": "^4.6.1",echo     "cors": "^2.8.5",echo     "multer": "^1.4.5-lts.1",echo     "xlsx": "^0.18.5",echo     "bcrypt": "^5.1.0",echo     "jsonwebtoken": "^9.0.0",echo     "sequelize": "^6.32.0",echo     "sqlite3": "^5.1.6"echo   }echo })  [1/4] Created package.jsonREM 2. Create app.js(echo const express = require('express');echo const { Server } = require('socket.io');echo const http = require('http');echo const cors = require('cors');echo const multer = require('multer');echo const XLSX = require('xlsx');echo const bcrypt = require('bcrypt');echo const jwt = require('jsonwebtoken');echo const { Sequelize, DataTypes } = require('sequelize');echo const path = require('path');echo.echo const app = express();echo const server = http.createServer(app);echo const io = new Server(server, { cors: { origin: '*', methods: ['GET', 'POST', 'PUT', 'DELETE'] } });echo.echo app.use(cors());echo app.use(express.json({ limit: '50mb' }));echo app.use(express.urlencoded({ extended: true, limit: '50mb' }));echo app.use(multer().none());echo.echo const sequelize = new Sequelize({ dialect: 'sqlite', storage: './ct20_data.db', logging: false });echo.echo const User = sequelize.define('User', { username: { type: DataTypes.STRING, unique: true }, passwordHash: DataTypes.STRING, role: { type: DataTypes.STRING, defaultValue: 'viewer' } });echo const Assembly = sequelize.define('Assembly', { assemblyNumber: { type: DataTypes.STRING, primaryKey: true }, assemblyName: DataTypes.STRING, qtyRequired: DataTypes.INTEGER, percentComplete: DataTypes.FLOAT, status: DataTypes.STRING });echo const Part = sequelize.define('Part', { id: { type: DataTypes.INTEGER, autoIncrement: true, primaryKey: true }, sNo: DataTypes.INTEGER, drawingNumber: DataTypes.STRING, name: DataTypes.STRING, qtyPerAssembly: DataTypes.INTEGER, percentCompleted: DataTypes.FLOAT, status: DataTypes.STRING, assemblyNumber: DataTypes.STRING });echo Assembly.hasMany(Part, { foreignKey: 'assemblyNumber' });echo.echo async function createDefaultAdmin() {echo   const existing = await User.count();echo   if (existing === 0) {echo     const hash = await bcrypt.hash('admin123', 10);echo     await User.create({ username: 'admin', passwordHash: hash, role: 'admin' });echo     console.log('Admin created: admin / admin123');echo   }echo }echo.echo function authenticate(req, res, next) {echo   const auth = req.headers.authorization;echo   if (!auth 
